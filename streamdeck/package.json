{
  "name": "micmute-streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart xyz.kayvan.micmute\"",
    "test": "vitest run",
    "validate": "streamdeck validate xyz.kayvan.micmute.sdPlugin",
    "link": "streamdeck link xyz.kayvan.micmute.sdPlugin",
    "restart": "streamdeck restart xyz.kayvan.micmute",
    "pack": "streamdeck pack xyz.kayvan.micmute.sdPlugin --output dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.6",
    "rollup": "^4.63.4",
    "tslib": "^2.8.1",
    "typescript": "~5.9",
    "vitest": "^5.0.1"
  }
}
